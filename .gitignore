/target
# Build output at any depth under examples/. The anchored `/examples/*/build`
# reached examples/c/build but not examples/build-systems/cmake/build, which
# is how a CMake cache, object files, dSYM bundles and native executables --
# with absolute local paths inside them -- were once committed by accident
# (review of #29).
build/
build-lib/
build-o2/
build-noexc/
# what a build that stopped part-way made (examples/adapter.sh, #286)
*.incomplete/
/examples/*/build
/examples/*/build-lib
*.profraw
*.profdata
evidence.json
.DS_Store
/examples/*/variants
*.png
!/ui/butterfly-logo.png
*.jpg

# worked build-system integrations
/examples/build-systems/*/build
/examples/build-systems/bazel/bazel-*

# Generated by examples/run-all.sh: reports sit beside their evidence, and
# bazel's evidence lands outside any build/ dir, so the rules above miss it.
# .run-all/ is its live state -- pids, ports and per-example logs.
report.html
/examples/.run-all/
# the CMake VS Code extension writes an absolute local path here
.vscode/

# Written by scripts/bench.sh; a run is a measurement, not a source file.
/bench.json

# The showcase page's screenshots are the one set of images that IS source:
# scripts/showcase.sh writes them and docs/showcase/index.html shows them.
!/docs/showcase/img/*.png
!/docs/showcase/img/*.jpg
# its single-file export is a build product
/docs/showcase/butterfly-showcase.html

# Local credentials, review material and generated outputs
/artifacts/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
!/docs/quickstart.png
node_modules/
**/*[Aa]udit*.md
/docs/qualification/DO-330-assessment.md
